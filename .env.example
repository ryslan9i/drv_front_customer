# Copy this file to .env.local (gitignored) and adjust for your environment.
# .env.local overrides these for your machine only and is never committed.

# "live" points the app at a real backend and skips starting the mock
# service worker. Any other value (or leaving this unset) runs fully
# against the in-browser mock, which is the default for local development.
VITE_API_MODE=mock

# Just the host — no /api suffix. Every route on this platform already
# starts with /api (auth: /api/auth, FutureSchool: /api/v1/future-school)
# and the client code adds that prefix itself.
# Leave empty (or unset) for same-origin / the mock.
# Example for a separately-running local backend — use 127.0.0.1, not
# localhost: some Kestrel + browser + WSL2 combinations resolve "localhost"
# to ::1 first, time out, then fall back to IPv4, adding a ~40s stall to the
# first request on a cold connection. 127.0.0.1 skips that entirely.
#   VITE_API_BASE_URL=http://127.0.0.1:5000
VITE_API_BASE_URL=
